---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardProjeto from '../components/CardProjeto.jsx';
import '../styles/animations.css';

import {projetosData} from '../data/projeto';


const sobreMim = {
	nome: "Lucas Edson",
descricao: `Desenvolvedor full stack, com experiência sólida no desenvolvimento de aplicações web.
Possuo expertise em tecnologias como Python, Node.js, PostgreSQL, e AWS. Apaixonado
por soluções escaláveis e eficientes, busco sempre aprimorar minhas habilidades em
desenvolvimento, arquitetura de sistemas e computação em nuvem.
`,
	tecnologias: ["Python", "Node.js", "AWS", "Django", "Next.js", "React", "Tailwind CSS"],
}

---


<BaseLayout title="Lucas Edson - Desenvolvedor Full Stack" description="Portfólio de Lucas Edson, desenvolvedor full stack especializado em Python, Node.js, AWS e soluções web escaláveis."> 

  {/* Seção Sobre Mim */}
  <section id="sobre" class="py-16 scroll-mt-20">
    <div class="container mx-auto px-4 md:px-0 translate-in-section rotate-out-section overflow-hidden">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="md:w-1/3 flex justify-center">
          <div class="gradient-border">
            <img src="https://avatars.githubusercontent.com/u/33698741?v=4" alt="Lucas Edson" class=" w-48 h-48 md:w-64 md:h-64 rounded-full object-cover shadow-lg">
          </div>
        </div>
        <div class="md:w-2/3 text-center md:text-left">
          <h1 class="text-4xl md:text-5xl font-bold gradient-text">Lucas Edson</h1>
          <p class="mt-4 text-lg md:text-xl secondary-text-light dark:secondary-text-dark">Desenvolvedor Full Stack</p>
          <p class="mt-8 text-base md:text-lg secondary-text-light dark:secondary-text-dark">{sobreMim.descricao}</p>
		      <p class="mt-4"><strong>Tecnologias:</strong> {sobreMim.tecnologias.map(
            (tech) => (
              <span class="gradient-bg-10 text-xs font-semibold px-2.5 py-0.5 mr-2 rounded-full tech-bg-light text-white">
                {tech}
              </span>
            )
          )}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Seção Projetos */}
  <section id="projetos" class="py-16 scroll-mt-20">
    <div class="container mx-auto px-4 md:px-0">
      <h2 class="text-4xl font-bold text-center mb-12 gradient-text">Meus Projetos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {projetosData.map((projeto) => (
          <CardProjeto
            client:visible 
            nome={projeto.nome}
            descricao={projeto.descricao}
            tecnologias={projeto.tecnologias}
            url={projeto.url}
            imagem={projeto.imagem}
            periodo={projeto.periodo}
          />
        ))}
      </div>
    </div>
  </section>

  {/* Seção Contato */}
  <section id="contato" class="py-16 scroll-mt-20">
     <div class="container mx-auto text-center px-4 md:px-0">
        <h2 class="text-4xl font-bold mb-8 gradient-text">Entre em Contato</h2>
        <p class="text-lg mb-6 max-w-xl mx-auto secondary-text-light dark:secondary-text-dark">
            Estou sempre aberto a novas oportunidades, projetos interessantes ou apenas para trocar uma ideia.
            Sinta-se à vontade para me contatar!
        </p>
        <a href="https://api.whatsapp.com/send?phone=5522991022601" class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors mb-8">
			Fale comigo
        </a>
        <div class="mt-8 flex justify-center space-x-6">
            <a href="https://www.linkedin.com/in/lucasedson/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-colors text-3xl primary-text-light dark:primary-text-dark" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <a href="https://github.com/lucasedson/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-colors text-3xl primary-text-light dark:primary-text-dark" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
        </div>
     </div>
  </section>
  <script is:inline>
  (function(d,t) {
    var BASE_URL="https://app.chatwoot.com";
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src=BASE_URL+"/packs/js/sdk.js";
    g.async = true;
    s.parentNode.insertBefore(g,s);
    g.onload=function(){
      window.chatwootSDK.run({
        websiteToken: 'nbFHH54UmXj8j8bETkFNE3VE',
        baseUrl: BASE_URL
      })
    }
  })(document,"script");
</script>

